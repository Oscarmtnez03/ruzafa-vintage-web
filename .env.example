# 1. Datos Fiscales del Titular para Cumplimiento Legal LSSI-CE / RGPD en España
# Completa el NIF/CIF real del autónomo o sociedad antes de publicar en el dominio definitivo:
NEXT_PUBLIC_LEGAL_OWNER_NAME="María José Martínez"
NEXT_PUBLIC_LEGAL_NIF=""

# 2. Variables de entorno opcionales para notificaciones externas del formulario (/api/presupuesto)
# Sin estas variables, el servidor valida y registra todas las solicitudes localmente en /data/solicitudes-presupuesto.json
# y ofrece al usuario el enlace contextualizado de WhatsApp con su código de referencia (RV-2026-XXXX).

# Opción A: Envío automático de email mediante Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=info@ruzafavintage.es

# Opción B: Envío automático a un Webhook (Make, Zapier, n8n, Slack, Telegram)
CONTACT_WEBHOOK_URL=
